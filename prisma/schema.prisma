generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String       @id @db.Uuid
  email               String?      @unique
  name                String?
  created_at          DateTime     @default(now()) @map("created_at")
  updated_at          DateTime     @default(now()) @updatedAt @map("updated_at")
  phone               String?
  created_allocations Allocation[] @relation("AllocationCreatedBy")
  org_memberships     OrgMember[]

  @@map("users")
}

model Org {
  id                   String        @id @default(dbgenerated("uuid7()")) @db.Uuid
  name                 String
  created_at           DateTime      @default(now()) @map("created_at")
  updated_at           DateTime      @default(now()) @updatedAt @map("updated_at")
  org_types            OrgType[]     @map("org_types")
  company_id           String?       @db.Uuid
  investor_allocations Allocation[]  @relation("AllocationInvestorOrg")
  members              OrgMember[]
  companies            Company?      @relation(fields: [company_id], references: [id])
  contractor_projects  Project[]     @relation("ProjectContractorOrg")
  lender_projects      Project[]     @relation("ProjectLenderOrg")
  realtor_projects     Project[]     @relation("ProjectRealtorOrg")
  transactions_to      Transaction[] @relation("TransactionToOrg")

  @@index([org_types])
  @@map("orgs")
}

model Role {
  name        String
  created_at  DateTime    @default(now()) @map("created_at")
  updated_at  DateTime    @default(now()) @updatedAt @map("updated_at")
  id          String      @id @default(dbgenerated("uuid7()")) @db.Uuid
  key         String      @unique
  org_members OrgMember[]

  @@map("roles")
}

model OrgMember {
  org_id     String   @map("org_id") @db.Uuid
  user_id    String   @map("user_id") @db.Uuid
  role_id    String   @map("role_id") @db.Uuid
  created_at DateTime @default(now()) @map("created_at")
  org        Org      @relation(fields: [org_id], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [role_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([org_id, user_id, role_id])
  @@index([user_id])
  @@index([org_id])
  @@index([role_id])
  @@map("org_members")
}

model Company {
  name              String
  created_at        DateTime      @default(now()) @map("created_at")
  updated_at        DateTime      @default(now()) @updatedAt @map("updated_at")
  id                String        @id @default(dbgenerated("uuid7()")) @db.Uuid
  orgs              Org[]
  projects          Project[]
  transactions_from Transaction[] @relation("TransactionFromCompany")

  @@map("companies")
}

model TitleCompany {
  id         String    @id @default(dbgenerated("uuid7()")) @db.Uuid
  name       String
  created_at DateTime  @default(now()) @map("created_at")
  updated_at DateTime  @default(now()) @updatedAt @map("updated_at")
  projects   Project[]

  @@map("title_companies")
}

model Project {
  address               String
  purchase_price        Decimal?      @default(0) @db.Decimal(12, 2)
  rehab_budget          Decimal?      @default(0) @db.Decimal(12, 2)
  after_repair_value    Decimal?      @default(0) @db.Decimal(12, 2)
  mortgage_amount       Decimal?      @default(0) @db.Decimal(12, 2)
  created_at            DateTime      @default(now()) @map("created_at")
  updated_at            DateTime      @default(now()) @updatedAt @map("updated_at")
  status                String        @default("active construction")
  id                    String        @id @default(dbgenerated("uuid7()")) @db.Uuid
  company_id            String        @map("company_id") @db.Uuid
  lender_org_id         String?       @map("lender_org_id") @db.Uuid
  purchase_closing_date DateTime?
  realtor_org_id        String?       @map("realtor_org_id") @db.Uuid
  sale_date             DateTime?
  contractor_org_id     String?       @map("contractor_org_id") @db.Uuid
  title_company_id      String?       @map("title_company_id") @db.Uuid
  allocations           Allocation[]
  company               Company       @relation(fields: [company_id], references: [id])
  contractor_org        Org?          @relation("ProjectContractorOrg", fields: [contractor_org_id], references: [id], onDelete: Restrict)
  lender_org            Org?          @relation("ProjectLenderOrg", fields: [lender_org_id], references: [id], onDelete: Restrict)
  realtor_org           Org?          @relation("ProjectRealtorOrg", fields: [realtor_org_id], references: [id], onDelete: Restrict)
  title_company         TitleCompany? @relation(fields: [title_company_id], references: [id])
  transactions          Transaction[] @relation("TransactionProject")

  @@index([company_id])
  @@index([title_company_id])
  @@index([lender_org_id])
  @@index([realtor_org_id])
  @@index([contractor_org_id])
  @@map("projects")
}

model Allocation {
  interest_rate_percentage Decimal       @db.Decimal(12, 2)
  investment_method        String
  investment_type          String
  profit_split_percentage  Decimal?      @db.Decimal(12, 2)
  payment_term             String
  distributed_to_date      Decimal       @default(0) @db.Decimal(12, 2)
  note_maturity_date       DateTime?     @db.Date
  created_at               DateTime      @default(now()) @map("created_at")
  updated_at               DateTime      @default(now()) @updatedAt @map("updated_at")
  status                   String        @default("active")
  allocation_amount        Decimal       @db.Decimal(12, 2)
  id                       String        @id @default(dbgenerated("uuid7()")) @db.Uuid
  project_id               String        @map("project_id") @db.Uuid
  created_by_user_id       String        @map("created_by_user_id") @db.Uuid
  investor_org_id          String        @map("investor_org_id") @db.Uuid
  investment_date          DateTime?     @db.Date
  inactive_date            DateTime?     @db.Date
  created_by               User          @relation("AllocationCreatedBy", fields: [created_by_user_id], references: [id])
  investor_org             Org           @relation("AllocationInvestorOrg", fields: [investor_org_id], references: [id])
  project                  Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  transactions             Transaction[]

  @@index([investor_org_id])
  @@index([created_by_user_id])
  @@index([project_id])
  @@map("allocations")
}

model Transaction {
  id              String     @id @default(dbgenerated("uuid7()")) @db.Uuid
  amount          Decimal    @db.Decimal(12, 2)
  to_org_id       String     @map("to_org_id") @db.Uuid
  allocation_id   String     @map("allocation_id") @db.Uuid
  project_id      String     @map("project_id") @db.Uuid
  created_at      DateTime   @default(now()) @map("created_at")
  updated_at      DateTime   @default(now()) @updatedAt @map("updated_at")
  from_company_id String     @map("from_company_id") @db.Uuid
  allocation      Allocation @relation(fields: [allocation_id], references: [id])
  from_company    Company    @relation("TransactionFromCompany", fields: [from_company_id], references: [id])
  project         Project    @relation("TransactionProject", fields: [project_id], references: [id])
  to_org          Org        @relation("TransactionToOrg", fields: [to_org_id], references: [id])

  @@index([from_company_id])
  @@index([to_org_id])
  @@index([allocation_id])
  @@index([project_id])
  @@index([created_at])
  @@map("transactions")
}

enum OrgType {
  internal
  investor
  lender
  realtor
  contractor
}

# Copy to `.env.local` and fill in values as needed.
# Auth / remote DB credentials are intentionally omitted until re-implemented.

# --- App ---
# Default app path: login success redirect + unknown-route not-found redirect (default: /dashboard)
NEXT_PUBLIC_HOME_PATH=/dashboard

# --- Logging (optional) ---
# Server-side debug logging (truthy enables)
DEBUG_LOG=1
# Client-side debug logging (truthy enables)
NEXT_PUBLIC_DEBUG_LOG=true
# Optional level filter: debug | info | warn | error (default: debug)
# DEBUG_LOG_LEVEL=debug
# NEXT_PUBLIC_DEBUG_LOG_LEVEL=debug

# --- Feature APIs (optional) ---
# Used by nl-filters / AI text-check routes
OPENAI_API_KEY_TEXT_CHECK=

# Used by Google Maps components
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
